[Unit]
Description=Claude Unchained Forge - backend FastAPI
After=network.target

[Service]
Type=simple
User=quentin
Group=quentin
WorkingDirectory=/var/www/forge/backend
ExecStart=/var/www/forge/backend/venv/bin/python -m uvicorn server:app --host 127.0.0.1 --port 8001 --workers 2
Restart=always
RestartSec=3
EnvironmentFile=/var/www/forge/backend/.env

# Durcissement et isolation
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/var/www/forge
ReadWritePaths=/var/www/forge/workspace /var/www/forge/.playwright /var/www/forge/backend/static/screenshots /dev/shm

[Install]
WantedBy=multi-user.target
