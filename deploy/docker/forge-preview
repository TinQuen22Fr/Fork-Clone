#
# forge-preview — wrapper STRICT de l'etape D2.
#   Seul point d'entree privilegie du backend vers Docker.
#   Installe sous /usr/local/bin/forge-preview, appele via sudoers dedie.
#
#   forge-preview <verbe> <projet> [options bornees]
#
# Verbes : start | stop | rm | ps | logs | inspect | exec | health | stats | prune
# Le projet est valide par regex (^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$).
# Toute commande arbitraire est refusee. Le conteneur est tenu en vie par
# une commande de garde interne (sleep infinity) ; le lancement metier (install/run)
# est fait par D5 via le verbe borne exec (aucune commande arbitraire).
# Aucun montage du socket Docker, jamais.
#
set -u -o pipefail

PROG="forge-preview"
DOCKER=/usr/bin/docker
PREVIEW_HOST=127.0.0.1
PORT_BASE=${PREVIEW_PORT_BASE:-8090}
PORT_MAX=${PREVIEW_PORT_MAX:-8189}
# L'API d'un projet ecoute sur port+100 (preview_runtime.API_PORT_OFFSET).
PORT_MAX=$(( PORT_MAX + 100 ))
IMAGE=${FORGE_PREVIEW_IMAGE:-forge-preview-base:local}
NETWORK=${FORGE_PREVIEW_NETWORK:-forge-preview-net}
ROOTS=${FORGE_PREVIEW_WORKSPACE_ROOTS:-/var/www/forge/workspace}

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 64; }

# --- Audit D9 : journaliser chaque start|stop (qui, quand, projet) -------
# Ecrit dans un fichier dedie ET dans syslog (logger). SUDO_USER identifie
# l'appelant d'origine quand le wrapper est invoque via sudo par le backend.
AUDIT_DIR=${FORGE_PREVIEW_AUDIT_DIR:-/var/log/forge-preview}
audit() {
  local verb=$1 project=$2 rc=$3
  local who ts line
  who=${SUDO_USER:-${LOGNAME:-${USER:-inconnu}}}
  ts=$(date '+%Y-%m-%dT%H:%M:%S%z')
  line="forge-preview audit ts=$ts who=$who verb=$verb project=$project rc=$rc"
  mkdir -p "$AUDIT_DIR" 2>/dev/null || true
  printf '%s\n' "$line" >> "$AUDIT_DIR/audit.log" 2>/dev/null || true
  if command -v logger >/dev/null 2>&1; then
    logger -t forge-preview "$line" 2>/dev/null || true
  fi
}


usage() {
  cat >&2 <<USAGE
Usage : $PROG <start|stop|rm|ps|logs|inspect|stats|health> <projet> [options]

  start   <projet> --port <p> --workspace <dir> [--cpus N] [--memory M] [--env CLE=VAL]...
  stop    <projet>
  rm      <projet>
  ps      <projet|-->
  logs    <projet> [--tail N]
  inspect <projet>
  stats   <projet>                    (CPU/RAM instantanes, D10)
  exec    <projet> --script <rel .forge-preview/*.sh> [--detach]
  health  <projet>
  prune   --older-days <N>      (rm des conteneurs arretes > N jours + image prune)
USAGE
  exit 64
}

valid_project() {
  case "$1" in
    ''|*/*|.*|*..*) return 1 ;;
  esac
  printf '%s' "$1" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$'
}

valid_int() { case "$1" in ''|*[!0-9]*) return 1 ;; esac; return 0; }
no_dash_value() { case "$1" in -*) die "valeur d'option invalide : $1" ;; esac; }

# --- Appel docker a config deterministe (pas de HOME utilisateur) -----------
# En execution sudo, HOME vaut /root : on force un DOCKER_CONFIG neutre pour
# eviter tout warning de config.json et toute lecture d'un profil utilisateur.
DKCFG="${FORGE_PREVIEW_DOCKER_CONFIG:-/var/lib/forge-preview/.docker}"
mkdir -p "$DKCFG" 2>/dev/null || { DKCFG="$(mktemp -d /tmp/forge-preview-dockercfg.XXXXXX 2>/dev/null)"; }
dk() {
  if [ -n "$DKCFG" ]; then
    "$DOCKER" --config "$DKCFG" "$@"
  else
    "$DOCKER" "$@"
  fi
}

# --- Verbe health : aucun projet, sert de controle sudoers ------------------
if [ "${1:-}" = "health" ]; then
  [ -x "$DOCKER" ] || die "docker introuvable ($DOCKER)"
  dk version --format '{{.Server.Version}}' 2>/dev/null | head -n1
  exit 0
fi

# --- Verbe prune : nettoyage periodique (pas de projet) ----------------------
if [ "${1:-}" = "prune" ]; then
  [ -x "$DOCKER" ] || die "docker introuvable ($DOCKER)"
  shift
  OLDER=30
  if [ $# -eq 2 ] && [ "$1" = "--older-days" ]; then
    valid_int "$2" || die "--older-days attend un entier"
    [ "$2" -ge 1 ] && [ "$2" -le 3650 ] || die "--older-days hors bornes (1-3650)"
    OLDER=$2
  elif [ $# -ne 0 ]; then
    die "option non reconnue pour prune"
  fi
  # Conteneurs forge-preview arretes (exited/created) depuis plus de OLDER jours.
  # Format : "<id> <AAAA-MM-JJ> <HH:MM:SS> <tz>" -> epoch via mktime (mawk/gawk).
  for CID in $(dk ps -a --filter "name=forge-preview-" --filter "status=exited" \
      --filter "status=created" --format '{{.ID}} {{.CreatedAt}}' 2>/dev/null | \
      awk -v days="$OLDER" '
        BEGIN { cutoff = systime() - days * 86400 }
        {
          id = $1; d = $2 " " $3
          gsub(/-/, " ", d); gsub(/:/, " ", d)
          split(d, a, " ")
          if (a[1] >= 2000) {
            ep = mktime(a[1] " " a[2] " " a[3] " " a[4] " " a[5] " " a[6])
            if (ep > 0 && ep <= cutoff) print id
          }
        }'); do
    dk rm -f "$CID" >/dev/null 2>&1 || true
  done
  # Images intermediaires / orphelines non utilisees par un conteneur.
  dk image prune -f >/dev/null 2>&1 || true
  printf '%s: prune ok (older-days=%s)\n' "$PROG" "$OLDER"
  exit 0
fi


[ $# -ge 2 ] || usage
VERB=$1; PROJECT=$2; shift 2

case "$VERB" in
  start|stop|rm|logs|inspect|exec|stats) valid_project "$PROJECT" || die "nom de projet invalide" ;;
  ps)
    if [ "$PROJECT" != "--" ]; then
      valid_project "$PROJECT" || die "nom de projet invalide"
    fi ;;
  *) usage ;;
esac

[ -x "$DOCKER" ] || die "docker introuvable ($DOCKER)"
NAME="forge-preview-$PROJECT"
STATEDIR="${FORGE_PREVIEW_STATE_ROOT:-/var/lib/forge-preview}/$PROJECT"

case "$VERB" in
stop|rm)
  [ $# -eq 0 ] || die "le verbe $VERB n'accepte aucune option"
  RC=0
  if [ "$VERB" = "rm" ]; then
    dk rm -f "$NAME" >/dev/null 2>&1 || RC=$?
  else
    dk stop --time 10 "$NAME" >/dev/null 2>&1 || RC=$?
  fi
  [ "$VERB" = "rm" ] && { rm -rf "$STATEDIR" 2>/dev/null || true; }
  printf '%s: %s %s (rc=%s)\n' "$PROG" "$VERB" "$NAME" "$RC" >&2
  audit "$VERB" "$PROJECT" "$RC"
  exit "$RC"
  ;;

ps)
  [ $# -eq 0 ] || die "option non reconnue pour ps"
  if [ "$PROJECT" = "--" ]; then
    dk ps -a --filter "name=forge-preview-" \
      --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
  else
    dk ps -a --filter "name=^${NAME}$" \
      --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
  fi
  ;;

logs)
  TAIL=200
  if [ $# -eq 2 ] && [ "$1" = "--tail" ]; then
    valid_int "$2" || die "--tail attend un entier"
    [ "$2" -ge 1 ] && [ "$2" -le 5000 ] || die "--tail hors bornes (1-5000)"
    TAIL=$2
  elif [ $# -ne 0 ]; then
    die "option non reconnue pour logs"
  fi
  dk logs --tail "$TAIL" "$NAME" 2>&1
  ;;

inspect)
  [ $# -eq 0 ] || die "option non reconnue pour inspect"
  dk inspect "$NAME"
  ;;

stats)
  [ $# -eq 0 ] || die "option non reconnue pour stats"
  dk stats --no-stream --format '{{.CPUPerc}}|{{.MemUsage}}|{{.PIDs}}' "$NAME" 2>&1
  ;;

exec)
  SCRIPT=""; DETACH=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --script)
        [ $# -ge 2 ] || die "--script attend un chemin relatif"
        case "$2" in .forge-preview/*.sh) ;; *) die "--script doit etre .forge-preview/<fichier>.sh" ;; esac
        case "$2" in */*/*|*..*) die "--script contient un chemin interdit" ;; esac
        SCRIPT=$2; shift 2 ;;
      --detach) DETACH=1; shift ;;
      *) die "option non reconnue pour exec : $1" ;;
    esac
  done
  [ -n "$SCRIPT" ] || die "exec exige --script <rel>"
  if [ "$DETACH" -eq 1 ]; then
    dk exec -d "$NAME" /bin/bash -lc "/workspace/$SCRIPT"
  else
    dk exec "$NAME" /bin/bash -lc "/workspace/$SCRIPT"
  fi
  ;;

start)
  PORT=""; PORT2=""; WORKSPACE=""; CPUS=1.0; MEMORY=1g; PIDSLIMIT=256
  ENVS=(); SEEN_PORT=0; SEEN_PORT2=0; SEEN_WS=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --port)
        [ $# -ge 2 ] || die "--port attend une valeur"
        no_dash_value "$2"
        valid_int "$2" || die "--port attend un entier"
        [ "$2" -ge "$PORT_BASE" ] && [ "$2" -le "$PORT_MAX" ] \
          || die "port $2 hors plage autorisee ($PORT_BASE-$PORT_MAX)"
        PORT=$2; SEEN_PORT=1; shift 2 ;;
      --port2)
        [ $# -ge 2 ] || die "--port2 attend une valeur"
        no_dash_value "$2"
        valid_int "$2" || die "--port2 attend un entier"
        [ "$2" -ge "$PORT_BASE" ] && [ "$2" -le "$PORT_MAX" ] \
          || die "port2 $2 hors plage autorisee ($PORT_BASE-$PORT_MAX)"
        PORT2=$2; SEEN_PORT2=1; shift 2 ;;
      --workspace)
        [ $# -ge 2 ] || die "--workspace attend un chemin"
        no_dash_value "$2"
        case "$2" in /*) ;; *) die "--workspace doit etre un chemin absolu" ;; esac
        RESOLVED=$(readlink -f -- "$2" 2>/dev/null) || die "--workspace introuvable : $2"
        [ -d "$RESOLVED" ] || die "--workspace n'est pas un dossier : $2"
        case "$RESOLVED" in */..|*/../*) die "--workspace contient une remontee interdite" ;; esac
        OKROOT=0
        IFS=':' read -r -a _roots <<< "$ROOTS"
        for _r in "${_roots[@]}"; do
          case "$RESOLVED" in "$_r"|"$_r"/*) OKROOT=1 ;; esac
        done
        [ "$OKROOT" -eq 1 ] || die "--workspace hors racine autorisee ($ROOTS)"
        WORKSPACE=$RESOLVED; SEEN_WS=1; shift 2 ;;
      --cpus)
        [ $# -ge 2 ] || die "--cpus attend une valeur"
        case "$2" in ''|*[!0-9.]*) die "--cpus numerique attendu" ;; esac
        CPUS=$2; shift 2 ;;
      --memory)
        [ $# -ge 2 ] || die "--memory attend une valeur"
        case "$2" in ''|*[!0-9a-zA-Z]*) die "--memory invalide" ;; esac
        MEMORY=$2; shift 2 ;;
      --env)
        [ $# -ge 2 ] || die "--env attend CLE=VAL"
        case "$2" in *=*) ;; *) die "--env attend CLE=VAL" ;; esac
        KEY=${2%%=*}
        case "$KEY" in
          ""|*[!A-Za-z0-9_]*) die "--env : nom de variable invalide" ;;
        esac
        case "$KEY" in
          LD_PRELOAD|LD_LIBRARY_PATH|DOCKER_HOST|PATH|BASH_ENV) die "--env $KEY interdit" ;;
        esac
        ENVS+=(--env "$2"); shift 2 ;;
      *) die "option non reconnue pour start : $1" ;;
    esac
  done
  [ "$SEEN_WS" -eq 1 ] || die "start exige --workspace <dir>"
  [ "$SEEN_PORT" -eq 1 ] || die "start exige --port <p>"
  dk network inspect "$NETWORK" >/dev/null 2>&1 || die "reseau $NETWORK absent (lancer install-d4.sh)"

  if dk inspect -f '{{.State.Running}}' "$NAME" >/dev/null 2>&1; then
    if [ "$(dk inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null)" = "true" ]; then
      die "conteneur $NAME deja en cours (stop d'abord)"
    fi
    # Conteneur homonyme non demarre (created/exited) : on le purge pour que
    # le prochain "dk run --name $NAME" ne bute pas sur "name already in use".
    dk rm -f "$NAME" >/dev/null 2>&1 || true
  fi
  # Filet de securite : un "dk run" precedent peut avoir laisse un conteneur
  # en etat "created" qu'inspect ne voit pas toujours selon la version.
  dk rm -f "$NAME" >/dev/null 2>&1 || true

  mkdir -p "$STATEDIR" 2>/dev/null || true
  # D14 : le venv conteneur vit HORS du workspace versionne, dans l'etat du
  # projet. On aligne la propriete du dossier d'etat sur celle du workspace
  # (UID/GID du user preview) pour que le venv y soit inscriptible.
  _ws_uid=$(stat -c '%u' "$WORKSPACE" 2>/dev/null || echo 1000)
  _ws_gid=$(stat -c '%g' "$WORKSPACE" 2>/dev/null || echo 1000)
  chown "${_ws_uid}:${_ws_gid}" "$STATEDIR" 2>/dev/null || true

  # Docker impose un hostname conforme RFC 1123 (minuscules, chiffres, tirets).
  # Le nom du projet peut contenir des majuscules/underscores (ex. Fork-Clone),
  # que dockerd refuse comme hostname -> on le normalise ici. Le nom du
  # conteneur ($NAME) garde la casse d'origine (Docker l'accepte).
  HOSTNAME_SAFE=$(printf '%s' "$PROJECT" \
    | tr '[:upper:]' '[:lower:]' \
    | tr -c 'a-z0-9-' '-' \
    | sed -e 's/^-*//' -e 's/-*$//')
  [ -n "$HOSTNAME_SAFE" ] || HOSTNAME_SAFE="preview"

  RUN_ARGS=(-d
    --name "$NAME"
    --hostname "$HOSTNAME_SAFE"
    --network "$NETWORK"
    -p "${PREVIEW_HOST}:${PORT}:${PORT}"
    --cpus "$CPUS"
    --memory "$MEMORY" --memory-swap "$MEMORY"
    --pids-limit "$PIDSLIMIT"
    --read-only
    --tmpfs /tmp:rw,size=256m,noexec,nosuid,nodev
    --tmpfs /run:rw,size=64m,noexec,nosuid,nodev
    --security-opt no-new-privileges
    --cap-drop ALL
    --restart=no
    -v "${WORKSPACE}:/workspace:rw"
    -v "${STATEDIR}:/forge-state:rw"
    -w /workspace
    --env "PORT=${PORT}"
    --env "HOST=127.0.0.1"
    --env "FORGE_PREVIEW=1"
    --env "FORGE_PREVIEW_PROJECT=${PROJECT}")
  if [ ${#ENVS[@]} -gt 0 ]; then RUN_ARGS+=("${ENVS[@]}"); fi
  if [ "$SEEN_PORT2" -eq 1 ]; then RUN_ARGS+=( -p "${PREVIEW_HOST}:${PORT2}:${PORT2}" ); fi
  RUN_ARGS+=("$IMAGE")
  # D4 : garde en vie sans executer de code projet. La commande metier est
  # lancee par D5 (preview_runtime) via le wrapper.
  RUN_OUT=$(dk run "${RUN_ARGS[@]}" sleep infinity 2>&1)
  RC=$?
  if [ "$RC" -ne 0 ]; then
    # Echec de creation : on nettoie un eventuel conteneur partiel et on
    # remonte la cause exacte (hostname invalide, port occupe, image absente...).
    dk rm -f "$NAME" >/dev/null 2>&1 || true
    printf '%s: echec dk run pour %s : %s\n' "$PROG" "$NAME" "$RUN_OUT" >&2
    audit "start" "$PROJECT" "$RC"
    exit "$RC"
  fi
  # Le conteneur doit reellement etre "running" ; sinon l'install (exec)
  # echouerait sur "No such container". On verifie et on remonte les logs.
  if [ "$(dk inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null)" != "true" ]; then
    CLOGS=$(dk logs "$NAME" 2>&1 | tail -n 20)
    dk rm -f "$NAME" >/dev/null 2>&1 || true
    printf '%s: conteneur %s cree mais non demarre : %s\n' "$PROG" "$NAME" "$CLOGS" >&2
    audit "start" "$PROJECT" 1
    exit 1
  fi
  audit "start" "$PROJECT" "$RC"
  exit "$RC"
  ;;

*)
  usage
  ;;
esac
