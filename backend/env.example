# =============================================================================
# Claude Unchained Forge — configuration backend
# Copier en .env et remplir. Ne jamais committer le .env réel.
# =============================================================================

# --- OBLIGATOIRE : sécurité JWT -------------------------------------------
# Générer avec :  openssl rand -base64 48
# Si absent, une clé éphémère est générée au démarrage et TOUTES les sessions
# sautent à chaque redémarrage du service.
JWT_SECRET=

# Durée de validité des tokens, en jours.
JWT_EXPIRE_DAYS=7


# --- OBLIGATOIRE : base de données ----------------------------------------
# MongoDB local (installation standard sur la Dedibox) :
MONGO_URL=mongodb://localhost:27017
# Avec authentification :
# MONGO_URL=mongodb://user:password@localhost:27017/?authSource=admin
DB_NAME=forge


# --- OBLIGATOIRE : CORS ----------------------------------------------------
# Origine EXACTE du frontend : schéma + hôte (+ port si non standard).
# Sans slash final, sans chemin. Plusieurs origines = séparées par des virgules.
FRONTEND_URL=https://forge.quentin-astro.fr
# En développement local, on peut ajouter :
# FRONTEND_URL=https://forge.quentin-astro.fr,http://localhost:3000


# --- Cookies ---------------------------------------------------------------
# true en HTTPS (cas Nginx + Let's Encrypt), false en HTTP local uniquement.
COOKIE_SECURE=true

# lax   : frontend et backend sur le MÊME domaine (recommandé, cf. Nginx ci-joint)
# none  : frontend et backend sur des domaines DIFFÉRENTS — impose COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# À renseigner uniquement pour partager le cookie entre sous-domaines.
# Ex : .quentin-astro.fr  (le point initial est significatif)
COOKIE_DOMAIN=


# --- Compte admin initial --------------------------------------------------
# Créé au premier démarrage seulement. Laisser ADMIN_PASSWORD vide pour ne
# créer aucun compte admin. Le mot de passe n'est jamais réécrit ensuite.
ADMIN_EMAIL=admin@forge.dev
ADMIN_PASSWORD=


# --- Limites ---------------------------------------------------------------
# Taille maximale d'une image envoyée, en Mo.
MAX_IMAGE_MB=8

# Nombre de messages d'historique renvoyés au moteur à chaque tour.
# Principal levier de coût si un moteur facturé au token est branché plus tard.
HISTORY_TURNS=20

# --- Inscription publique --------------------------------------------------
# false (défaut) : /api/auth/register renvoie 403. Recommandé pour une
# instance exposée sur Internet — seul le compte admin peut se connecter.
# true : n'importe qui peut créer un compte.
ALLOW_REGISTRATION=false


# --- Claude (abonnement Pro/Max via jeton OAuth) ---------------------------
# AUCUNE API payante au token. On utilise le jeton d'abonnement Claude Code.
# Générer sur une machine avec navigateur :
#   npm i -g @anthropic-ai/claude-code
#   claude setup-token          (se connecter avec le compte Pro/Max)
# Le jeton commence par sk-ant-oat... et est valable ~1 an.
CLAUDE_CODE_OAUTH_TOKEN=

# Identifiant EXACT du modèle (tirets, pas de points). Ex : claude-sonnet-5,
# claude-opus-4-8, claude-haiku-4-5-20251001...
CLAUDE_MODEL=claude-sonnet-5

# Nombre max de tokens en sortie par réponse.
CLAUDE_MAX_TOKENS=4096

# Prompt système (personnalité de l'assistant). Optionnel.
# CLAUDE_SYSTEM_PROMPT=

# --- Tool Calling (capacités agentiques) -----------------------------------
# true (défaut) : Claude peut exécuter des outils bash + read_file SUR LE SERVEUR.
# ⚠️ DANGER : l'outil bash exécute des commandes arbitraires avec les droits de
# l'utilisateur du backend. À n'activer que sur une instance personnelle de
# confiance. Mettre false pour désactiver complètement les outils.
ENABLE_TOOLS=true

# --- Gemini (Google AI Studio) ---------------------------------------------
# Clé API depuis https://aistudio.google.com/apikey (quota gratuit).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Modele de secours si le principal est surcharge (503) ou retire.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# --- Ollama (moteur local, gratuit) ----------------------------------------
# Nécessite Ollama installé + un modèle pull.
# ⚠️ CPU FAIBLE (ex: Atom C2338, 2 cœurs, SANS AVX2, 4 Go RAM) : privilégier
# un TRÈS petit modèle quantifié. Pour du code, recommandé :
#     ollama pull qwen2.5-coder:1.5b     (bon compromis code / vitesse)
#     ollama pull qwen2.5-coder:0.5b     (plus rapide, moins bon)
# Modèles 3B+ possibles seulement avec plus de swap/RAM (lent).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b

# Réglages perf (adaptés CPU lent). Baisse num_ctx/num_predict si trop lent.
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=768
OLLAMA_NUM_THREAD=2
OLLAMA_KEEP_ALIVE=10m
OLLAMA_TIMEOUT=600

# --- Ollama Cloud (moteur distant) ----------------------------------------
# Cle depuis https://ollama.com/settings/keys
# NB : l'offre gratuite d'un compte n'inclut PAS tous les modeles. Verifie via
#   curl -H "Authorization: Bearer $OLLAMA_CLOUD_API_KEY" https://ollama.com/api/tags
# Modeles constates gratuits sur un compte sans credits : gpt-oss:120b,
# nemotron-3-nano:30b. Les deepseek-v4-* / glm-5.3 / kimi-k2.6 demandent des
# credits ("this model is not included in your free usage").
OLLAMA_CLOUD_URL=https://ollama.com/api
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_MODEL=deepseek-v4-pro:0813
# Modele de secours essaye AVANT de basculer sur un autre provider.
OLLAMA_CLOUD_FALLBACK_MODEL=gpt-oss:120b
OLLAMA_CLOUD_TIMEOUT=180

# --- OpenCode Zen / Go (passerelle compatible OpenAI) ----------------------
# Cle depuis la console : https://console.opencode.ai (Go > API keys).
# NB OpenCode v2 : l'app/CLI passe en v2 mais l'API HTTP reste identique,
# toujours sur /zen/go/v1 (seule la console a demenage sur console.opencode.ai).
# Deux passerelles possibles :
#   https://opencode.ai/zen/go/v1  -> abonnement Go 10$/mois (modeles ouverts)
#   https://opencode.ai/zen/v1     -> catalogue complet, facture au token (solde)
# Liste des modeles :
#   curl -H "Authorization: Bearer $OPENCODE_API_KEY" https://opencode.ai/zen/go/v1/models
#
# ⚠️ EXIGENCES OpenCode Go (sinon erreur MissingSessionID) :
#   - un User-Agent identifiable (pas un nom de lib HTTP) -> OPENCODE_USER_AGENT
#   - un id de session stable par conversation dans l'en-tete x-opencode-session
#     -> la forge envoie automatiquement l'id de la conversation.
#
# La forge gere les TROIS transports de la passerelle, detectes automatiquement
# d'apres l'id du modele (et reessayes entre eux si l'endpoint ne colle pas) :
#   /chat/completions (format OpenAI)   : deepseek-*, glm-*, kimi-*, mimo-*,
#                                         hy3, hy4-preview, longcat-2.0, grok-*
#   /messages         (format Anthropic): minimax-*, qwen3.*
#                                         (auth via x-api-key, gere)
#   /responses        (OpenAI Responses): gpt-5.6-luna, muse-spark-*
# Forcer un transport si besoin : auto (defaut) | chat | messages | responses
OPENCODE_TRANSPORT=auto
#
# ⚠️ Les modeles deepseek-v4-* sont heberges en Chine et demandent un opt-in
# explicite a cocher dans le workspace (https://console.opencode.ai -> Go).
# Sans cet opt-in, l'API renvoie "RegionError" et la forge bascule sur
# OPENCODE_FALLBACK_MODEL.
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4-flash
OPENCODE_FALLBACK_MODEL=glm-5.3-flash
OPENCODE_TIMEOUT=180
OPENCODE_USER_AGENT=claude-unchained-forge/1.0

# --- Routeur multi-providers et bascule automatique ------------------------
# Ordre de priorite utilise par le mode "Auto" et par la cascade de secours.
# Providers valides : claude, gemini, ollama_cloud, opencode, ollama
# Le provider local `ollama` est TOUJOURS repousse en dernier recours.
PROVIDER_PRIORITY=claude,gemini,ollama_cloud,opencode,ollama

# true (defaut) : si le modele choisi echoue (4xx/5xx, timeout, quota, credits,
# restriction free-tier, region...), la forge bascule automatiquement et
# silencieusement sur le provider disponible suivant, puis en dernier recours
# sur Ollama local. Chaque bascule est loggee.
# false : une erreur provider remonte directement au frontend.
ENABLE_FALLBACK=true
